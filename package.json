  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.0",
    "@solana/spl-token": "^0.4.9"
  },
  "overrides": {
    "rpc-websockets": {
      "uuid": "^9.0.1"
    }
  }
}
